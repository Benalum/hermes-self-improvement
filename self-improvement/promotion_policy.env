# Hermes self-improvement promotion policy.
# Automatic production promotion remains OFF until final on-Mac validation.
AUTO_PROMOTE_MODE=off
MAX_RUNTIME_SECONDS=5400
MAX_TURNS=80
MAX_CHANGED_FILES=20
MAX_CHANGED_LINES=800
VALIDATION_TIMEOUT_SECONDS=1800
HEALTH_TIMEOUT_SECONDS=180
STARTUP_BENCH_RUNS=3
MAX_STARTUP_REGRESSION_PCT=25
MAX_STARTUP_REGRESSION_ABS_SECONDS=0.25
RUN_FULL_TESTS=true
RUN_LLM_HEALTH=false
RETAIN_NO_CHANGE_WORKTREES=3
BASELINE_VALIDATION_CACHE_SECONDS=86400
BASELINE_VALIDATION_TIMEOUT_SECONDS=1800

# Direct discovery classifier + Hermes implementation workflow
DISCOVERY_MODEL=qwen3.5:4b-mlx
IMPLEMENTATION_MODEL=gemma4:31b-mlx
DISCOVERY_RUNTIME_SECONDS=150
# Legacy compatibility only; direct Ollama discovery does not use Hermes turns.
DISCOVERY_TURNS=4
# Legacy compatibility only; direct Ollama discovery uses think=false.
DISCOVERY_REASONING=minimal
IMPLEMENTATION_REASONING=medium

# Controller-owned rotating fresh probe for known-red baselines
FRESH_PROBE_TIMEOUT_SECONDS=45
FRESH_PROBE_MAX_ATTEMPTS=3
